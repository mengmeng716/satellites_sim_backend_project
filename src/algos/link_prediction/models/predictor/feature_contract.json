    "age_norm": "窗口内相对位置，0=最新一步，1=最老一步"
  },
  "graph_contract": {
    "version": "entity-graph-v1",
    "rationale": "预测实体是有向链路与节点：链路按“共享端点”建无向图（两条链路共享同一卫星即相邻），节点按拓扑邻接建图，并加入链路—端点节点的异构边；自环 + 对称归一化。",
    "entity_space": {
      "source": "src.prediction.dataset._entity_ids / WindowedDataset.C['entity_ids']",
      "pattern": {
        "link": "^\\d+->\\d+$（有向链路 'u->v'，端点 u/v 为卫星节点 ID）",
        "node": "^\\d+$（纯数字节点 ID）"
      },
      "ordering": "前 n_links 行 = link，后 n_nodes 行 = node（与 dataset 一致）"
    },
    "edge_rules": {
      "link_link": "两条链路 (u,v) 与 (u',v') 共享任一端点（u==u' 或 u==v' 或 v==u' 或 v==v'）即为无向相邻",
      "node_node": "两节点之间存在任一方向的已登记链路即为无向相邻；链路取自场景完整拓扑（静态结构，不读取观测特征）",
      "link_node": "链路与其两个端点节点相邻（异构边）：节点负载可聚合入射链路状态，链路可聚合端点负载",
      "self_loops": true,
      "directedness": "原链路为有向，图为无向（共享端点关系对称）"
    },
    "normalization": {
      "gcn": "A_hat = D^{-1/2}(A+I)D^{-1/2}",
      "gat": "同一邻接掩码（含自环）上做邻域 LeakyReLU 注意力 + softmax"
    },
    "split_policy": {
      "rule": "按实体切分后取子图：训练/验证/测试分别只用本切分实体的诱导子图",
      "link_link": "只在当前子集内的链路之间建边",
      "link_node": "只在当前子集内的节点上建边",
      "node_node": "使用静态拓扑结构（不含任何其他切分实体的观测特征）",
      "leakage": "模型从不把验证/测试实体的观测当作输入；图结构本身是公开静态拓扑"
    },
    "topology_source": "scene_topology"
  }
}